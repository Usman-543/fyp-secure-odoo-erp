# Copy this file to configs/postgres.env and fill in real values.
# NEVER commit the real configs/postgres.env file.

POSTGRES_DB=odoo
POSTGRES_USER=odoo
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
PGDATA=/var/lib/postgresql/data/pgdata

# Used by docker-compose for the Odoo service
ODOO_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
